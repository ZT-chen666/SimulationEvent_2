  18              	#ifndef __CORE_FEATURE_ECLIC__
  19              	#define __CORE_FEATURE_ECLIC__
  20              	/*!
  21              	 * @file     core_feature_eclic.h
  22              	 * @brief    ECLIC feature API header file for Nuclei N/NX Core
  23              	 */
  24              	/*
  25              	 * ECLIC Feature Configuration Macro:
  26              	 * 1. __ECLIC_PRESENT:  Define whether Enhanced Core Local Interrupt Controller (ECLIC) Unit is pre
  27              	 *   * 0: Not present
  28              	 *   * 1: Present
  29              	 * 2. __ECLIC_BASEADDR:  Base address of the ECLIC unit.
  30              	 * 3. __ECLIC_INTCTLBITS:  Optional, if defined, it should set to the value of ECLIC_GetInfoCtlbits
  31              	 *   Valid number is 1 - 8.
  32              	 * 4. __ECLIC_INTNUM:  Define the external interrupt number of ECLIC Unit
  33              	 * 5. __TEE_PRESENT:  Define whether TEE feature present, if present, ECLIC will present with S-Mod
  34              	 *   * 0: Not present
  35              	 *   * 1: Present
  36              	 *
  37              	 */
  38              	#ifdef __cplusplus
  39              	extern "C" {
  40              	#endif
  41              	
  42              	#include "core_feature_base.h"
  43              	
  44              	#if defined(__ECLIC_PRESENT) && (__ECLIC_PRESENT == 1)
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccdV3Oec.s 			page 10


  45              	/**
  46              	 * \defgroup NMSIS_Core_ECLIC_Registers     Register Define and Type Definitions Of ECLIC
  47              	 * \ingroup NMSIS_Core_Registers
  48              	 * \brief   Type definitions and defines for eclic registers.
  49              	 *
  50              	 * @{
  51              	 */
  52              	
  53              	/**
  54              	 * \brief  Union type to access CLICFG configure register.
  55              	 */
  56              	typedef union
  57              	{
  58              	    struct {
  59              	        __IM uint8_t _reserved0:1;
  60              	        __IOM uint8_t nlbits:4;                /*!< bit:     1..4 specified the bit-width of level 
  61              	        __IM uint8_t nmbits:2;                 /*!< bit:     5..6 ties to 1 if supervisor-level int
  62              	        __IM uint8_t _reserved1:1;
  63              	    } b;                                       /*!< Structure used for bit  access */
  64              	    uint8_t w;                                 /*!< Type      used for byte access */
  65              	} CLICCFG_Type;
  66              	
  67              	/**
  68              	 * \brief  Union type to access CLICINFO information register.
  69              	 */
  70              	typedef union {
  71              	    struct {
  72              	        __IM uint32_t numint:13;               /*!< bit:  0..12   number of maximum interrupt input
  73              	        __IM uint32_t version:8;               /*!< bit:  13..20  20:17 for architecture version,16
  74              	        __IM uint32_t intctlbits:4;            /*!< bit:  21..24  specifies how many hardware bits 
  75              	        __IM uint32_t _reserved0:7;            /*!< bit:  25..31  Reserved */
  76              	    } b;                                       /*!< Structure used for bit  access */
  77              	    __IM uint32_t w;                           /*!< Type      used for word access */
  78              	} CLICINFO_Type;
  79              	
  80              	/**
  81              	 * \brief Access to the machine mode register structure of INTIP, INTIE, INTATTR, INTCTL.
  82              	 */
  83              	typedef struct {
  84              	    __IOM uint8_t INTIP;                       /*!< Offset: 0x000 (R/W)  Interrupt set pending regi
  85              	    __IOM uint8_t INTIE;                       /*!< Offset: 0x001 (R/W)  Interrupt set enable regis
  86              	    __IOM uint8_t INTATTR;                     /*!< Offset: 0x002 (R/W)  Interrupt set attributes r
  87              	    __IOM uint8_t INTCTRL;                     /*!< Offset: 0x003 (R/W)  Interrupt configure regist
  88              	} CLIC_CTRL_Type;
  89              	
  90              	/**
  91              	 * \brief Access to the structure of ECLIC Memory Map, which is compatible with TEE.
  92              	 */
  93              	typedef struct {
  94              	    __IOM uint8_t CFG;                         /*!< Offset: 0x000 (R/W)  CLIC configuration registe
  95              	    __IM uint8_t RESERVED0[3];
  96              	    __IM uint32_t INFO;                        /*!< Offset: 0x004 (R/ )  CLIC information register 
  97              	    __IM uint8_t RESERVED1;
  98              	#if defined(__TEE_PRESENT) && (__TEE_PRESENT == 1)
  99              	    __IOM uint8_t STH;                         /*!<  Offset: 0x009 (R/W )  CLIC supervisor mode int
 100              	#else
 101              	    __IM uint8_t RESERVED2;
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccdV3Oec.s 			page 11


 102              	#endif
 103              	    __IM uint8_t RESERVED3;
 104              	    __IOM uint8_t MTH;                         /*!< Offset: 0x00B(R/W)  CLIC machine mode interrupt
 105              	    uint32_t RESERVED4[1021];
 106              	#if defined(__TEE_PRESENT) && (__TEE_PRESENT == 1)
 107              	    CLIC_CTRL_Type CTRL[1024];                 /*!< Offset: 0x1000 (R/W) CLIC machine mode register
 108              	    __IM uint32_t RESERVED5[2];
 109              	    __IM uint8_t RESERVED6;
 110              	    __IOM uint8_t SSTH;                        /*!< Offset: 0x2009 (R)  CLIC supervisor mode thresh
