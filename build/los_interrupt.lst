 589              	 * - \ref ECLIC_SetShvIRQ
 590              	 */
 591              	__STATIC_FORCEINLINE uint32_t __ECLIC_GetShvIRQ(IRQn_Type IRQn)
 592              	{
 593              	    return ((uint32_t)(((ECLIC->CTRL[IRQn].INTATTR) & CLIC_INTATTR_SHV_Msk) >> CLIC_INTATTR_SHV_Pos
 594              	}
