 303              	/**
 304              	 * \brief  Set nlbits value
 305              	 * \details
 306              	 * This function set the nlbits value of CLICCFG register.
 307              	 * \param [in]    nlbits    nlbits value
 308              	 * \remarks
 309              	 * - nlbits is used to set the width of level in the CLICINTCTL[i].
 310              	 * \sa
 311              	 * - \ref ECLIC_GetCfgNlbits
 312              	 */
 313              	__STATIC_FORCEINLINE void __ECLIC_SetCfgNlbits(uint32_t nlbits)
 314              	{
 315              	    uint8_t temp = ECLIC->CFG;
 316              	
 317              	    ECLIC->CFG = (temp & ~CLIC_CLICCFG_NLBIT_Msk) | \
 318              	                 ((uint8_t)((nlbits << CLIC_CLICCFG_NLBIT_Pos) & CLIC_CLICCFG_NLBIT_Msk));
 319              	}
 320              	
 321              	/**
 322              	 * \brief  Get nlbits value
 323              	 * \details
 324              	 * This function get the nlbits value of CLICCFG register.
 325              	 * \return   nlbits value of CLICCFG register
 326              	 * \remarks
 327              	 * - nlbits is used to set the width of level in the CLICINTCTL[i].
 328              	 * \sa
 329              	 * - \ref ECLIC_SetCfgNlbits
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccdV3Oec.s 			page 15


 330              	 */
 331              	__STATIC_FORCEINLINE uint32_t __ECLIC_GetCfgNlbits(void)
 332              	{
 333              	    return ((uint32_t)((ECLIC->CFG & CLIC_CLICCFG_NLBIT_Msk) >> CLIC_CLICCFG_NLBIT_Pos));
 334              	}
