 1052              	/**
 1053              	 * \brief   Read whole 64 bits value of mcycle counter
 1054              	 * \details This function will read the whole 64 bits of MCYCLE register
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccWuIUWJ.s 			page 20


 1055              	 * \return  The whole 64 bits value of MCYCLE
 1056              	 * \remarks It will work for both RV32 and RV64 to get full 64bits value of MCYCLE
 1057              	 */
 1058              	__STATIC_FORCEINLINE uint64_t __get_rv_cycle(void)
 1059              	{
 1060              	#if __RISCV_XLEN == 32
 1061              	    volatile uint32_t high0, low, high;
 1062              	    uint64_t full;
 1063              	
 1064              	    high0 = __RV_CSR_READ(CSR_MCYCLEH);
 1065              	    low = __RV_CSR_READ(CSR_MCYCLE);
 1066              	    high = __RV_CSR_READ(CSR_MCYCLEH);
 1067              	    if (high0 != high) {
 1068              	        low = __RV_CSR_READ(CSR_MCYCLE);
 1069              	    }
 1070              	    full = (((uint64_t)high) << 32) | low;
 1071              	    return full;
 1072              	#elif __RISCV_XLEN == 64
 1073              	    return (uint64_t)__RV_CSR_READ(CSR_MCYCLE);
 1074              	#else // TODO Need cover for XLEN=128 case in future
