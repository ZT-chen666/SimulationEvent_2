  35              	.LM8:
  36              	 #APP
  37              	# 1308 "liteos_m//kernel/arch/risc-v/nuclei/gcc/nmsis/Core/Include/core_feature_base.h" 1
 1309              	}
  38              		wfi
  39              	# 0 "" 2
  40              	 #NO_APP
  41              	.LBE6:
  42              	.LBE5:
  43              	.LM9:
  44 0008 E5BF     		j	.L2
