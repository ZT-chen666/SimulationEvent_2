 1296              	/**
 1297              	 * \brief   Wait For Interrupt
 1298              	 * \details
 1299              	 * Wait For Interrupt is is executed using CSR_WFE.WFE=0 and WFI instruction.
 1300              	 * It will suspends execution until interrupt, NMI or Debug happened.
 1301              	 * When Core is waked up by interrupt, if
 1302              	 * 1. mstatus.MIE == 1(interrupt enabled), Core will enter ISR code
 1303              	 * 2. mstatus.MIE == 0(interrupt disabled), Core will resume previous execution
 1304              	 */
 1305              	__STATIC_FORCEINLINE void __WFI(void)
