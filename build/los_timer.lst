 614              	/**
 615              	 * \brief CSR operation Macro for csrrw instruction.
 616              	 * \details
 617              	 * Read the content of csr register to __v,
 618              	 * then write content of val into csr register, then return __v
 619              	 * \param csr   CSR macro definition defined in
 620              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 621              	 * \param val   value to store into the CSR register
 622              	 * \return the CSR register value before written
 623              	 */
 624              	#define __RV_CSR_SWAP(csr, val)                                 \
 625              	    ({                                                          \
 626              	        rv_csr_t __v = (unsigned long)(val);                    \
 627              	        __ASM volatile("csrrw %0, " STRINGIFY(csr) ", %1"       \
 628              	                     : "=r"(__v)                                \
 629              	                     : "rK"(__v)                                \
 630              	                     : "memory");                               \
 631              	        __v;                                                    \
 632              	    })
 633              	
 634              	/**
 635              	 * \brief CSR operation Macro for csrr instruction.
 636              	 * \details
 637              	 * Read the content of csr register to __v and return it
 638              	 * \param csr   CSR macro definition defined in
 639              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 640              	 * \return the CSR register value
 641              	 */
 642              	#define __RV_CSR_READ(csr)                                      \
 643              	    ({                                                          \
 644              	        rv_csr_t __v;                                           \
 645              	        __ASM volatile("csrr %0, " STRINGIFY(csr)               \
 646              	                     : "=r"(__v)                                \
 647              	                     :                                          \
 648              	                     : "memory");                               \
 649              	        __v;                                                    \
 650              	    })
 651              	
