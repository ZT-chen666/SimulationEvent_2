 1056              	 * \remarks It will work for both RV32 and RV64 to get full 64bits value of MCYCLE
 1057              	 */
 1058              	__STATIC_FORCEINLINE uint64_t __get_rv_cycle(void)
 1059              	{
 1060              	#if __RISCV_XLEN == 32
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccLCpZub.s 			page 21


 1061              	    volatile uint32_t high0, low, high;
