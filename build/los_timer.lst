 1915              	 * \brief   Set exceptions delegation to S mode
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccLCpZub.s 			page 36


 1916              	 * \details Set certain exceptions of supervisor mode or user mode
 1917              	 *          delegated from machined mode to supervisor mode.
 1918              	 * \remarks
 1919              	 *          Exception should trigger in supervisor mode or user mode.
 1920              	 */
 1921              	__STATIC_FORCEINLINE void __set_medeleg(unsigned long mask)
 1922              	{
