 706              	/**
 707              	 * \brief CSR operation Macro for csrrc instruction.
 708              	 * \details
 709              	 * Read the content of csr register to __v,
 710              	 * then set csr register to be __v & ~val, then return __v
 711              	 * \param csr   CSR macro definition defined in
 712              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 713              	 * \param val   Mask value to be used wih csrrc instruction
 714              	 * \return the CSR register value before written
 715              	 */
 716              	#define __RV_CSR_READ_CLEAR(csr, val)                           \
 717              	    ({                                                          \
 718              	        rv_csr_t __v = (rv_csr_t)(val);                         \
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccLCpZub.s 			page 15


 719              	        __ASM volatile("csrrc %0, " STRINGIFY(csr) ", %1"       \
 720              	                     : "=r"(__v)                                \
 721              	                     : "rK"(__v)                                \
 722              	                     : "memory");                               \
 723              	        __v;                                                    \
 724              	    })
 725              	
 726              	/**
 727              	 * \brief CSR operation Macro for csrc instruction.
 728              	 * \details
 729              	 * Set csr register to be csr_content & ~val
 730              	 * \param csr   CSR macro definition defined in
 731              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 732              	 * \param val   Mask value to be used wih csrc instruction
 733              	 */
 734              	#define __RV_CSR_CLEAR(csr, val)                                \
 735              	    ({                                                          \
 736              	        rv_csr_t __v = (rv_csr_t)(val);                         \
 737              	        __ASM volatile("csrc " STRINGIFY(csr) ", %0"            \
 738              	                     :                                          \
 739              	                     : "rK"(__v)                                \
 740              	                     : "memory");                               \
 741              	    })
 742              	#else
 743              	
 744              	#include <intrinsics.h>
 745              	
 746              	#define __RV_CSR_SWAP         __write_csr
 747              	#define __RV_CSR_READ         __read_csr
 748              	#define __RV_CSR_WRITE        __write_csr
 749              	#define __RV_CSR_READ_SET     __set_bits_csr
 750              	#define __RV_CSR_SET          __set_bits_csr
 751              	#define __RV_CSR_READ_CLEAR   __clear_bits_csr
 752              	#define __RV_CSR_CLEAR        __clear_bits_csr
 753              	
 754              	#endif /* __ICCRISCV__ */
 755              	
 756              	#endif /* __ASSEMBLY__ */
