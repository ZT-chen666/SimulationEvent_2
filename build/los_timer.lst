 1064              	    high0 = __RV_CSR_READ(CSR_MCYCLEH);
 1065              	    low = __RV_CSR_READ(CSR_MCYCLE);
 1066              	    high = __RV_CSR_READ(CSR_MCYCLEH);
 1067              	    if (high0 != high) {
 1068              	        low = __RV_CSR_READ(CSR_MCYCLE);
 1069              	    }
