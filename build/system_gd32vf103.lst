 694              	/**
 695              	 * \brief  Get ECLIC Interrupt priority of a specific interrupt
 696              	 * \details
 697              	 * This function get interrupt priority of the specific interrupt \em IRQn.
 698              	 * \param [in]      IRQn  Interrupt number
 699              	 * \param [in]      pri   Interrupt priority
 700              	 * \remarks
 701              	 * - IRQn must not be negative.
 702              	 * - If pri to be set is larger than the max priority allowed, it will be force to be max priority.
 703              	 * - Priority width is CLICINTCTLBITS minus clciinfo.nlbits if clciinfo.nlbits
 704              	 *   is less than CLICINTCTLBITS. Otherwise priority width is 0.
 705              	 * \sa
 706              	 * - \ref ECLIC_GetPriorityIRQ
 707              	 */
 708              	__STATIC_FORCEINLINE void __ECLIC_SetPriorityIRQ(IRQn_Type IRQn, uint8_t pri)
 709              	{
 710              	    uint8_t nlbits = __ECLIC_GetCfgNlbits();
 711              	    uint8_t intctlbits = (uint8_t)__ECLIC_INTCTLBITS;
 712              	    if (nlbits < intctlbits) {
 713              	        uint8_t maxpri = ((1 << (intctlbits - nlbits)) - 1);
 714              	        if (pri > maxpri) {
 715              	            pri = maxpri;
 716              	        }
 717              	        pri = pri << (ECLIC_MAX_NLBITS - intctlbits);
 718              	        uint8_t mask = ((uint8_t)(-1)) >> intctlbits;
 719              	        pri = pri | mask;
 720              	        uint8_t cur_ctrl = __ECLIC_GetCtrlIRQ(IRQn);
 721              	        cur_ctrl = cur_ctrl >> (ECLIC_MAX_NLBITS - nlbits);
 722              	        cur_ctrl = cur_ctrl << (ECLIC_MAX_NLBITS - nlbits);
 723              	        __ECLIC_SetCtrlIRQ(IRQn, (cur_ctrl | pri));
 724              	    }
 725              	}
 726              	
 727              	/**
 728              	 * \brief  Get ECLIC Interrupt priority of a specific interrupt
 729              	 * \details
 730              	 * This function get interrupt priority of the specific interrupt \em IRQn.
 731              	 * \param [in]      IRQn  Interrupt number
 732              	 * \return   Interrupt priority
 733              	 * \remarks
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccEs3Cx1.s 			page 42


 734              	 * - IRQn must not be negative.
 735              	 * \sa
 736              	 * - \ref ECLIC_SetPriorityIRQ
 737              	 */
 738              	__STATIC_FORCEINLINE uint8_t __ECLIC_GetPriorityIRQ(IRQn_Type IRQn)
 739              	{
 740              	    uint8_t nlbits = __ECLIC_GetCfgNlbits();
 741              	    uint8_t intctlbits = (uint8_t)__ECLIC_INTCTLBITS;
 742              	    if (nlbits < intctlbits) {
 743              	        uint8_t cur_ctrl = __ECLIC_GetCtrlIRQ(IRQn);
 744              	        uint8_t pri = cur_ctrl << nlbits;
 745              	        pri = pri >> nlbits;
 746              	        pri = pri >> (ECLIC_MAX_NLBITS - intctlbits);
 747              	        return pri;
 748              	    } else {
 749              	        return 0;
 750              	    }
 751              	}
