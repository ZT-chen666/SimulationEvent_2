  40              	/**
  41              	 * \defgroup  NMSIS_Core_SystemAndClock   System and Clock Configuration
  42              	 * \brief Functions for system and clock setup available in system_<device>.c.
  43              	 * \details
  44              	 * Nuclei provides a template file **system_Device.c** that must be adapted by
  45              	 * the silicon vendor to match their actual device. As a <b>minimum requirement</b>,
  46              	 * this file must provide:
  47              	 *  -  A device-specific system configuration function, \ref SystemInit().
  48              	 *  -  A global variable that contains the system frequency, \ref SystemCoreClock.
  49              	 *
  50              	 * The file configures the device and, typically, initializes the oscillator (PLL) that is part
  51              	 * of the microcontroller device. This file might export other functions or variables that provide
  52              	 * a more flexible configuration of the microcontroller system.
  53              	 *
  54              	 * \note Please pay special attention to the static variable \c SystemCoreClock. This variable migh
  55              	 * used throughout the whole system initialization and runtime to calculate frequency/time related 
  56              	 * Thus one must assure that the variable always reflects the actual system clock speed.
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccEs3Cx1.s 			page 3


  57              	 *
  58              	 * \attention
  59              	 * Be aware that a value stored to \c SystemCoreClock during low level initialization (i.e. \c Syst
  60              	 * overwritten by C libray startup code and/or .bss section initialization.
  61              	 * Thus its highly recommended to call \ref SystemCoreClockUpdate at the beginning of the user \c m
  62              	 *
  63              	 * @{
  64              	 */
  65              	
  66              	/*----------------------------------------------------------------------------
  67              	  System Core Clock Variable
  68              	 *----------------------------------------------------------------------------*/
  69              	/* ToDo: initialize SystemCoreClock with the system core clock frequency value
  70              	         achieved after system intitialization.
  71              	         This means system core clock frequency after call to SystemInit() */
  72              	/**
  73              	 * \brief      Variable to hold the system core clock value
  74              	 * \details
  75              	 * Holds the system core clock, which is the system clock frequency supplied to the SysTick
  76              	 * timer and the processor core clock. This variable can be used by debuggers to query the
  77              	 * frequency of the debug timer or to configure the trace clock speed.
  78              	 *
  79              	 * \attention
  80              	 * Compilers must be configured to avoid removing this variable in case the application
  81              	 * program is not using it. Debugging systems require the variable to be physically
  82              	 * present in memory so that it can be examined to configure the debugger.
  83              	 */
  84              	uint32_t SystemCoreClock = __SYSTEM_CLOCK_108M_PLL_HXTAL;  /* System Clock Frequency (Core Clock) *
  85              	
  86              	/*----------------------------------------------------------------------------
  87              	  Clock functions
  88              	 *----------------------------------------------------------------------------*/
  89              	
  90              	/*!
  91              	    \brief      configure the system clock to 108M by PLL which selects HXTAL(MD/HD/XD:8M; CL:25M) 
  92              	    \param[in]  none
  93              	    \param[out] none
  94              	    \retval     none
  95              	*/
  96              	
  97              	static void system_clock_108m_hxtal(void)
  98              	{
  99              	    uint32_t timeout = 0U;
 100              	    uint32_t stab_flag = 0U;
 101              	
 102              	    /* enable HXTAL */
 103              	    RCU_CTL |= RCU_CTL_HXTALEN;
 104              	
 105              	    /* wait until HXTAL is stable or the startup time is longer than
 106              	     * HXTAL_STARTUP_TIMEOUT */
 107              	    do {
 108              	        timeout++;
 109              	        stab_flag = (RCU_CTL & RCU_CTL_HXTALSTB);
 110              	    } while ((0U == stab_flag) && (HXTAL_STARTUP_TIMEOUT != timeout));
 111              	
 112              	    /* if fail */
 113              	    if (0U == (RCU_CTL & RCU_CTL_HXTALSTB)) {
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccEs3Cx1.s 			page 4


 114              	        while (1) {
 115              	        }
 116              	    }
 117              	
 118              	    /* HXTAL is stable */
 119              	    /* AHB = SYSCLK */
 120              	    RCU_CFG0 |= RCU_AHB_CKSYS_DIV1;
 121              	    /* APB2 = AHB/1 */
 122              	    RCU_CFG0 |= RCU_APB2_CKAHB_DIV1;
 123              	    /* APB1 = AHB/2 */
 124              	    RCU_CFG0 |= RCU_APB1_CKAHB_DIV2;
 125              	
 126              	    /* CK_PLL = (CK_PREDIV0) * 27 = 108 MHz */
 127              	    RCU_CFG0 &= ~(RCU_CFG0_PLLMF | RCU_CFG0_PLLMF_4);
 128              	    RCU_CFG0 |= (RCU_PLLSRC_HXTAL | RCU_PLL_MUL27);
 129              	
 130              	    if (HXTAL_VALUE == 25000000) {
 131              	        /* CK_PREDIV0 = (CK_HXTAL)/5 *8 /10 = 4 MHz */
 132              	        RCU_CFG1 &= ~(RCU_CFG1_PREDV0SEL | RCU_CFG1_PREDV1 | RCU_CFG1_PLL1MF |
 133              	                      RCU_CFG1_PREDV0);
 134              	        RCU_CFG1 |= (RCU_PREDV0SRC_CKPLL1 | RCU_PREDV1_DIV5 | RCU_PLL1_MUL8 |
 135              	                     RCU_PREDV0_DIV10);
 136              	
 137              	        /* enable PLL1 */
 138              	        RCU_CTL |= RCU_CTL_PLL1EN;
 139              	        /* wait till PLL1 is ready */
 140              	        while (0U == (RCU_CTL & RCU_CTL_PLL1STB)) {
 141              	        }
 142              	
 143              	        /* enable PLL1 */
 144              	        RCU_CTL |= RCU_CTL_PLL2EN;
 145              	        /* wait till PLL1 is ready */
 146              	        while (0U == (RCU_CTL & RCU_CTL_PLL2STB)) {
 147              	        }
 148              	    } else if (HXTAL_VALUE == 8000000) {
 149              	        RCU_CFG1 &= ~(RCU_CFG1_PREDV0SEL | RCU_CFG1_PREDV1 | RCU_CFG1_PLL1MF |
 150              	                      RCU_CFG1_PREDV0);
 151              	        RCU_CFG1 |= (RCU_PREDV0SRC_HXTAL | RCU_PREDV0_DIV2 | RCU_PREDV1_DIV2 |
 152              	                     RCU_PLL1_MUL20 | RCU_PLL2_MUL20);
 153              	
 154              	        /* enable PLL1 */
 155              	        RCU_CTL |= RCU_CTL_PLL1EN;
 156              	        /* wait till PLL1 is ready */
 157              	        while (0U == (RCU_CTL & RCU_CTL_PLL1STB)) {
 158              	        }
 159              	
 160              	        /* enable PLL2 */
 161              	        RCU_CTL |= RCU_CTL_PLL2EN;
 162              	        /* wait till PLL1 is ready */
 163              	        while (0U == (RCU_CTL & RCU_CTL_PLL2STB)) {
 164              	        }
 165              	    }
 166              	    /* enable PLL */
 167              	    RCU_CTL |= RCU_CTL_PLLEN;
 168              	
 169              	    /* wait until PLL is stable */
 170              	    while (0U == (RCU_CTL & RCU_CTL_PLLSTB)) {
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccEs3Cx1.s 			page 5


 171              	    }
 172              	
 173              	    /* select PLL as system clock */
 174              	    RCU_CFG0 &= ~RCU_CFG0_SCS;
 175              	    RCU_CFG0 |= RCU_CKSYSSRC_PLL;
 176              	
 177              	    /* wait until PLL is selected as system clock */
 178              	    while (0U == (RCU_CFG0 & RCU_SCSS_PLL)) {
 179              	    }
 180              	}
 181              	
 182              	/*!
 183              	    \brief      configure the system clock
 184              	    \param[in]  none
 185              	    \param[out] none
 186              	    \retval     none
 187              	*/
 188              	static void system_clock_config(void)
 189              	{
 190              	    system_clock_108m_hxtal();
 191              	}
 192              	
 193              	
 194              	/**
 195              	 * \brief      Function to update the variable \ref SystemCoreClock
 196              	 * \details
 197              	 * Updates the variable \ref SystemCoreClock and must be called whenever the core clock is changed
 198              	 * during program execution. The function evaluates the clock register settings and calculates
 199              	 * the current core clock.
 200              	 */
 201              	void SystemCoreClockUpdate (void)            /* Get Core Clock Frequency */
 202              	{
 203              	    /* ToDo: add code to calculate the system frequency based upon the current
 204              	     *    register settings.
 205              	     * Note: This function can be used to retrieve the system core clock
 206              	     * frequeny after user changed register settings.
 207              	     */
 208              	    uint32_t scss;
 209              	    uint32_t pllsel, predv0sel, pllmf, ck_src;
 210              	    uint32_t predv0, predv1, pll1mf;
 211              	
 212              	    scss = GET_BITS(RCU_CFG0, 2, 3);
 213              	
 214              	    switch (scss) {
 215              	        /* IRC8M is selected as CK_SYS */
 216              	        case SEL_IRC8M:
 217              	            SystemCoreClock = IRC8M_VALUE;
 218              	            break;
 219              	
 220              	        /* HXTAL is selected as CK_SYS */
 221              	        case SEL_HXTAL:
 222              	            SystemCoreClock = HXTAL_VALUE;
 223              	            break;
 224              	
 225              	        /* PLL is selected as CK_SYS */
 226              	        case SEL_PLL:
 227              	            /* PLL clock source selection, HXTAL or IRC8M/2 */
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccEs3Cx1.s 			page 6


 228              	            pllsel = (RCU_CFG0 & RCU_CFG0_PLLSEL);
 229              	
 230              	            if (RCU_PLLSRC_IRC8M_DIV2 == pllsel) {
 231              	                /* PLL clock source is IRC8M/2 */
 232              	                ck_src = IRC8M_VALUE / 2U;
 233              	            } else {
 234              	                /* PLL clock source is HXTAL */
 235              	                ck_src = HXTAL_VALUE;
 236              	
 237              	                predv0sel = (RCU_CFG1 & RCU_CFG1_PREDV0SEL);
 238              	
 239              	                /* source clock use PLL1 */
 240              	                if (RCU_PREDV0SRC_CKPLL1 == predv0sel) {
 241              	                    predv1 = ((RCU_CFG1 & RCU_CFG1_PREDV1) >> 4) + 1U;
 242              	                    pll1mf = ((RCU_CFG1 & RCU_CFG1_PLL1MF) >> 8) + 2U;
 243              	                    if (17U == pll1mf) {
 244              	                        pll1mf = 20U;
 245              	                    }
 246              	                    ck_src = (ck_src / predv1) * pll1mf;
 247              	                }
 248              	                predv0 = (RCU_CFG1 & RCU_CFG1_PREDV0) + 1U;
 249              	                ck_src /= predv0;
 250              	            }
 251              	
 252              	            /* PLL multiplication factor */
 253              	            pllmf = GET_BITS(RCU_CFG0, 18, 21);
 254              	
 255              	            if ((RCU_CFG0 & RCU_CFG0_PLLMF_4)) {
 256              	                pllmf |= 0x10U;
 257              	            }
 258              	
 259              	            if (pllmf >= 15U) {
 260              	                pllmf += 1U;
 261              	            } else {
 262              	                pllmf += 2U;
 263              	            }
 264              	
 265              	            SystemCoreClock = ck_src * pllmf;
 266              	
 267              	            if (15U == pllmf) {
 268              	                /* PLL source clock multiply by 6.5 */
 269              	                SystemCoreClock = ck_src * 6U + ck_src / 2U;
 270              	            }
 271              	
 272              	            break;
 273              	
 274              	        /* IRC8M is selected as CK_SYS */
 275              	        default:
 276              	            SystemCoreClock = IRC8M_VALUE;
 277              	            break;
 278              	    }
 279              	}
