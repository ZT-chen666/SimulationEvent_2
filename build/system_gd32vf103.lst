 628              	/**
 629              	 * \brief  Set ECLIC Interrupt level of a specific interrupt
 630              	 * \details
 631              	 * This function set interrupt level of the specific interrupt \em IRQn.
 632              	 * \param [in]      IRQn  Interrupt number
 633              	 * \param [in]      lvl_abs   Interrupt level
 634              	 * \remarks
 635              	 * - IRQn must not be negative.
 636              	 * - If lvl_abs to be set is larger than the max level allowed, it will be force to be max level.
 637              	 * - When you set level value you need use clciinfo.nlbits to get the width of level.
 638              	 *   Then we could know the maximum of level. CLICINTCTLBITS is how many total bits are
 639              	 *   present in the CLICINTCTL register.
 640              	 * \sa
 641              	 * - \ref ECLIC_GetLevelIRQ
 642              	 */
 643              	__STATIC_FORCEINLINE void __ECLIC_SetLevelIRQ(IRQn_Type IRQn, uint8_t lvl_abs)
 644              	{
 645              	    uint8_t nlbits = __ECLIC_GetCfgNlbits();
 646              	    uint8_t intctlbits = (uint8_t)__ECLIC_INTCTLBITS;
 647              	
 648              	    if (nlbits == 0) {
 649              	        return;
 650              	    }
 651              	
 652              	    if (nlbits > intctlbits) {
 653              	        nlbits = intctlbits;
 654              	    }
 655              	    uint8_t maxlvl = ((1 << nlbits) - 1);
 656              	    if (lvl_abs > maxlvl) {
 657              	        lvl_abs = maxlvl;
 658              	    }
 659              	    uint8_t lvl = lvl_abs << (ECLIC_MAX_NLBITS - nlbits);
 660              	    uint8_t cur_ctrl = __ECLIC_GetCtrlIRQ(IRQn);
 661              	    cur_ctrl = cur_ctrl << nlbits;
 662              	    cur_ctrl = cur_ctrl >> nlbits;
 663              	    __ECLIC_SetCtrlIRQ(IRQn, (cur_ctrl | lvl));
 664              	}
 665              	
 666              	/**
 667              	 * \brief  Get ECLIC Interrupt level of a specific interrupt
 668              	 * \details
 669              	 * This function get interrupt level of the specific interrupt \em IRQn.
 670              	 * \param [in]      IRQn  Interrupt number
 671              	 * \return         Interrupt level
 672              	 * \remarks
 673              	 * - IRQn must not be negative.
 674              	 * \sa
 675              	 * - \ref ECLIC_SetLevelIRQ
 676              	 */
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccEs3Cx1.s 			page 41


 677              	__STATIC_FORCEINLINE uint8_t __ECLIC_GetLevelIRQ(IRQn_Type IRQn)
 678              	{
 679              	    uint8_t nlbits = __ECLIC_GetCfgNlbits();
 680              	    uint8_t intctlbits = (uint8_t)__ECLIC_INTCTLBITS;
 681              	
 682              	    if (nlbits == 0) {
 683              	        return 0;
 684              	    }
 685              	
 686              	    if (nlbits > intctlbits) {
 687              	        nlbits = intctlbits;
 688              	    }
 689              	    uint8_t intctrl = __ECLIC_GetCtrlIRQ(IRQn);
 690              	    uint8_t lvl_abs = intctrl >> (ECLIC_MAX_NLBITS - nlbits);
 691              	    return lvl_abs;
 692              	}
