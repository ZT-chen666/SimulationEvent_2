 281              	/**
 282              	 * \brief      Function to Initialize the system.
 283              	 * \details
 284              	 * Initializes the microcontroller system. Typically, this function configures the
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccEs3Cx1.s 			page 7


 285              	 * oscillator (PLL) that is part of the microcontroller device. For systems
 286              	 * with a variable clock speed, it updates the variable \ref SystemCoreClock.
 287              	 * SystemInit is called from the file <b>startup<i>_device</i></b>.
 288              	 */
 289              	void SystemInit (void)
 290              	{
 291              	    /* ToDo: add code to initialize the system
 292              	     * Warn: do not use global variables because this function is called before
 293              	     * reaching pre-main. RW section maybe overwritten afterwards.
 294              	     */
 295              	    /* reset the RCC clock configuration to the default reset state */
 296              	    /* enable IRC8M */
 297              	    RCU_CTL |= RCU_CTL_IRC8MEN;
 298              	
 299              	    /* reset SCS, AHBPSC, APB1PSC, APB2PSC, ADCPSC, CKOUT0SEL bits */
 300              	    RCU_CFG0 &= ~(RCU_CFG0_SCS | RCU_CFG0_AHBPSC | RCU_CFG0_APB1PSC | RCU_CFG0_APB2PSC |
 301              	                  RCU_CFG0_ADCPSC | RCU_CFG0_ADCPSC_2 | RCU_CFG0_CKOUT0SEL);
 302              	
 303              	    /* reset HXTALEN, CKMEN, PLLEN bits */
 304              	    RCU_CTL &= ~(RCU_CTL_HXTALEN | RCU_CTL_CKMEN | RCU_CTL_PLLEN);
 305              	
 306              	    /* Reset HXTALBPS bit */
 307              	    RCU_CTL &= ~(RCU_CTL_HXTALBPS);
 308              	
 309              	    /* reset PLLSEL, PREDV0_LSB, PLLMF, USBFSPSC bits */
 310              	
 311              	    RCU_CFG0 &= ~(RCU_CFG0_PLLSEL | RCU_CFG0_PREDV0_LSB | RCU_CFG0_PLLMF |
 312              	                  RCU_CFG0_USBFSPSC | RCU_CFG0_PLLMF_4);
 313              	    RCU_CFG1 = 0x00000000U;
 314              	
 315              	    /* Reset HXTALEN, CKMEN, PLLEN, PLL1EN and PLL2EN bits */
 316              	    RCU_CTL &= ~(RCU_CTL_PLLEN | RCU_CTL_PLL1EN | RCU_CTL_PLL2EN | RCU_CTL_CKMEN | RCU_CTL_HXTALEN)
 317              	    /* disable all interrupts */
 318              	    RCU_INT = 0x00FF0000U;
 319              	
 320              	    /* Configure the System clock source, PLL Multiplier, AHB/APBx prescalers and Flash settings */
 321              	    system_clock_config();
 322              	}
