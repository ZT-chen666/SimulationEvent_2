  94              	      \arg        WFE_CMD: use WFE command
  95              	    \param[out] none
  96              	    \retval     none
  97              	*/
  98              	void pmu_to_sleepmode(uint8_t sleepmodecmd)
  99              	{
 100              	    /* clear sleepdeep bit of RISC-V system control register */
 101 0000 73F00081 	    __RV_CSR_CLEAR(CSR_WFE, WFE_WFE);
