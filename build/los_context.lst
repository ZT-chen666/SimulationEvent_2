 1971              	/* ===== Load/Store Operations ===== */
 1972              	/**
 1973              	 * \brief  Load 8bit value from address (8 bit)
 1974              	 * \details Load 8 bit value.
 1975              	 * \param [in]    addr  Address pointer to data
 1976              	 * \return              value of type uint8_t at (*addr)
 1977              	 */
 1978              	__STATIC_FORCEINLINE uint8_t __LB(volatile void *addr)
 1979              	{
 1980              	    uint8_t result;
 1981              	
 1982              	    __ASM volatile ("lb %0, 0(%1)" : "=r" (result) : "r" (addr));
 1983              	    return result;
 1984              	}
 1985              	
