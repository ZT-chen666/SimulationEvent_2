 1988              	 * \details Load 16 bit value.
 1989              	 * \param [in]    addr  Address pointer to data
 1990              	 * \return              value of type uint16_t at (*addr)
 1991              	 */
 1992              	__STATIC_FORCEINLINE uint16_t __LH(volatile void *addr)
 1993              	{
 1994              	    uint16_t result;
 1995              	
 1996              	    __ASM volatile ("lh %0, 0(%1)" : "=r" (result) : "r" (addr));
 1997              	    return result;
 1998              	}
