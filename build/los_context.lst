 1052              	/**
 1053              	 * \brief   Read whole 64 bits value of mcycle counter
 1054              	 * \details This function will read the whole 64 bits of MCYCLE register
 1055              	 * \return  The whole 64 bits value of MCYCLE
 1056              	 * \remarks It will work for both RV32 and RV64 to get full 64bits value of MCYCLE
 1057              	 */
 1058              	__STATIC_FORCEINLINE uint64_t __get_rv_cycle(void)
