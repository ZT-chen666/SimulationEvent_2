 1274              	/* ###########################  CPU Intrinsic Functions ########################### */
 1275              	/**
 1276              	 * \defgroup NMSIS_Core_CPU_Intrinsic   Intrinsic Functions for CPU Intructions
 1277              	 * \ingroup  NMSIS_Core
 1278              	 * \brief    Functions that generate RISC-V CPU instructions.
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccI5Ycc4.s 			page 29


 1279              	 * \details
 1280              	 *
 1281              	 * The following functions generate specified RISC-V instructions that cannot be directly accessed 
 1282              	 *   @{
 1283              	 */
 1284              	
 1285              	/**
 1286              	 * \brief   NOP Instruction
 1287              	 * \details
 1288              	 * No Operation does nothing.
 1289              	 * This instruction can be used for code alignment purposes.
 1290              	 */
 1291              	__STATIC_FORCEINLINE void __NOP(void)
 1292              	{
 1293              	    __ASM volatile("nop");
 1294              	}
 1295              	
 1296              	/**
 1297              	 * \brief   Wait For Interrupt
 1298              	 * \details
 1299              	 * Wait For Interrupt is is executed using CSR_WFE.WFE=0 and WFI instruction.
 1300              	 * It will suspends execution until interrupt, NMI or Debug happened.
 1301              	 * When Core is waked up by interrupt, if
 1302              	 * 1. mstatus.MIE == 1(interrupt enabled), Core will enter ISR code
 1303              	 * 2. mstatus.MIE == 0(interrupt disabled), Core will resume previous execution
 1304              	 */
 1305              	__STATIC_FORCEINLINE void __WFI(void)
 1306              	{
 1307              	    __RV_CSR_CLEAR(CSR_WFE, WFE_WFE);
 1308              	    __ASM volatile("wfi");
 1309              	}
 1310              	
 1311              	/**
 1312              	 * \brief   Wait For Event
 1313              	 * \details
 1314              	 * Wait For Event is executed using CSR_WFE.WFE=1 and WFI instruction.
 1315              	 * It will suspends execution until event, NMI or Debug happened.
 1316              	 * When Core is waked up, Core will resume previous execution
 1317              	 */
 1318              	__STATIC_FORCEINLINE void __WFE(void)
 1319              	{
 1320              	    __RV_CSR_SET(CSR_WFE, WFE_WFE);
 1321              	    __ASM volatile("wfi");
 1322              	    __RV_CSR_CLEAR(CSR_WFE, WFE_WFE);
 1323              	}
 1324              	
 1325              	/**
 1326              	 * \brief   Breakpoint Instruction
 1327              	 * \details
 1328              	 * Causes the processor to enter Debug state.
 1329              	 * Debug tools can use this to investigate system state
 1330              	 * when the instruction at a particular address is reached.
 1331              	 */
 1332              	__STATIC_FORCEINLINE void __EBREAK(void)
 1333              	{
 1334              	    __ASM volatile("ebreak");
 1335              	}
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccI5Ycc4.s 			page 30


 1336              	
