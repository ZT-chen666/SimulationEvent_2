 719              	        __ASM volatile("csrrc %0, " STRINGIFY(csr) ", %1"       \
 720              	                     : "=r"(__v)                                \
 721              	                     : "rK"(__v)                                \
 722              	                     : "memory");                               \
 723              	        __v;                                                    \
 724              	    })
