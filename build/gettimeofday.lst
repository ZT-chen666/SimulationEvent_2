 726              	/**
 727              	 * \brief CSR operation Macro for csrc instruction.
 728              	 * \details
 729              	 * Set csr register to be csr_content & ~val
 730              	 * \param csr   CSR macro definition defined in
 731              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 732              	 * \param val   Mask value to be used wih csrc instruction
 733              	 */
 734              	#define __RV_CSR_CLEAR(csr, val)                                \
 735              	    ({                                                          \
 736              	        rv_csr_t __v = (rv_csr_t)(val);                         \
 737              	        __ASM volatile("csrc " STRINGIFY(csr) ", %0"            \
 738              	                     :                                          \
 739              	                     : "rK"(__v)                                \
 740              	                     : "memory");                               \
 741              	    })
 742              	#else
 743              	
 744              	#include <intrinsics.h>
 745              	
