 611              	
 612              	#ifndef __ICCRISCV__
 613              	
 614              	/**
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccSz8prT.s 			page 13


 615              	 * \brief CSR operation Macro for csrrw instruction.
 616              	 * \details
 617              	 * Read the content of csr register to __v,
 618              	 * then write content of val into csr register, then return __v
 619              	 * \param csr   CSR macro definition defined in
 620              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 621              	 * \param val   value to store into the CSR register
 622              	 * \return the CSR register value before written
 623              	 */
 624              	#define __RV_CSR_SWAP(csr, val)                                 \
 625              	    ({                                                          \
 626              	        rv_csr_t __v = (unsigned long)(val);                    \
 627              	        __ASM volatile("csrrw %0, " STRINGIFY(csr) ", %1"       \
 628              	                     : "=r"(__v)                                \
 629              	                     : "rK"(__v)                                \
 630              	                     : "memory");                               \
 631              	        __v;                                                    \
 632              	    })
 633              	
 634              	/**
 635              	 * \brief CSR operation Macro for csrr instruction.
 636              	 * \details
 637              	 * Read the content of csr register to __v and return it
 638              	 * \param csr   CSR macro definition defined in
 639              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 640              	 * \return the CSR register value
 641              	 */
 642              	#define __RV_CSR_READ(csr)                                      \
 643              	    ({                                                          \
 644              	        rv_csr_t __v;                                           \
 645              	        __ASM volatile("csrr %0, " STRINGIFY(csr)               \
 646              	                     : "=r"(__v)                                \
 647              	                     :                                          \
 648              	                     : "memory");                               \
 649              	        __v;                                                    \
 650              	    })
 651              	
 652              	/**
 653              	 * \brief CSR operation Macro for csrw instruction.
 654              	 * \details
 655              	 * Write the content of val to csr register
 656              	 * \param csr   CSR macro definition defined in
 657              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 658              	 * \param val   value to store into the CSR register
 659              	 */
 660              	#define __RV_CSR_WRITE(csr, val)                                \
 661              	    ({                                                          \
 662              	        rv_csr_t __v = (rv_csr_t)(val);                         \
 663              	        __ASM volatile("csrw " STRINGIFY(csr) ", %0"            \
 664              	                     :                                          \
 665              	                     : "rK"(__v)                                \
 666              	                     : "memory");                               \
 667              	    })
 668              	
 669              	/**
 670              	 * \brief CSR operation Macro for csrrs instruction.
 671              	 * \details
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccSz8prT.s 			page 14


 672              	 * Read the content of csr register to __v,
 673              	 * then set csr register to be __v | val, then return __v
 674              	 * \param csr   CSR macro definition defined in
 675              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 676              	 * \param val   Mask value to be used wih csrrs instruction
 677              	 * \return the CSR register value before written
 678              	 */
 679              	#define __RV_CSR_READ_SET(csr, val)                             \
 680              	    ({                                                          \
 681              	        rv_csr_t __v = (rv_csr_t)(val);                         \
 682              	        __ASM volatile("csrrs %0, " STRINGIFY(csr) ", %1"       \
 683              	                     : "=r"(__v)                                \
 684              	                     : "rK"(__v)                                \
 685              	                     : "memory");                               \
 686              	        __v;                                                    \
 687              	    })
 688              	
 689              	/**
 690              	 * \brief CSR operation Macro for csrs instruction.
 691              	 * \details
 692              	 * Set csr register to be csr_content | val
 693              	 * \param csr   CSR macro definition defined in
 694              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 695              	 * \param val   Mask value to be used wih csrs instruction
 696              	 */
 697              	#define __RV_CSR_SET(csr, val)                                  \
 698              	    ({                                                          \
 699              	        rv_csr_t __v = (rv_csr_t)(val);                         \
 700              	        __ASM volatile("csrs " STRINGIFY(csr) ", %0"            \
 701              	                     :                                          \
 702              	                     : "rK"(__v)                                \
 703              	                     : "memory");                               \
 704              	    })
 705              	
 706              	/**
 707              	 * \brief CSR operation Macro for csrrc instruction.
 708              	 * \details
 709              	 * Read the content of csr register to __v,
 710              	 * then set csr register to be __v & ~val, then return __v
 711              	 * \param csr   CSR macro definition defined in
 712              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 713              	 * \param val   Mask value to be used wih csrrc instruction
 714              	 * \return the CSR register value before written
 715              	 */
 716              	#define __RV_CSR_READ_CLEAR(csr, val)                           \
 717              	    ({                                                          \
 718              	        rv_csr_t __v = (rv_csr_t)(val);                         \
 719              	        __ASM volatile("csrrc %0, " STRINGIFY(csr) ", %1"       \
 720              	                     : "=r"(__v)                                \
 721              	                     : "rK"(__v)                                \
 722              	                     : "memory");                               \
 723              	        __v;                                                    \
 724              	    })
 725              	
 726              	/**
 727              	 * \brief CSR operation Macro for csrc instruction.
 728              	 * \details
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccSz8prT.s 			page 15


 729              	 * Set csr register to be csr_content & ~val
 730              	 * \param csr   CSR macro definition defined in
 731              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 732              	 * \param val   Mask value to be used wih csrc instruction
 733              	 */
 734              	#define __RV_CSR_CLEAR(csr, val)                                \
 735              	    ({                                                          \
 736              	        rv_csr_t __v = (rv_csr_t)(val);                         \
 737              	        __ASM volatile("csrc " STRINGIFY(csr) ", %0"            \
 738              	                     :                                          \
 739              	                     : "rK"(__v)                                \
 740              	                     : "memory");                               \
 741              	    })
 742              	#else
 743              	
 744              	#include <intrinsics.h>
 745              	
 746              	#define __RV_CSR_SWAP         __write_csr
 747              	#define __RV_CSR_READ         __read_csr
 748              	#define __RV_CSR_WRITE        __write_csr
 749              	#define __RV_CSR_READ_SET     __set_bits_csr
 750              	#define __RV_CSR_SET          __set_bits_csr
 751              	#define __RV_CSR_READ_CLEAR   __clear_bits_csr
 752              	#define __RV_CSR_CLEAR        __clear_bits_csr
 753              	
 754              	#endif /* __ICCRISCV__ */
 755              	
 756              	#endif /* __ASSEMBLY__ */
 757              	
 758              	/**
 759              	 * \brief switch privilege from machine mode to others.
 760              	 * \details
 761              	 *  Execute into \ref entry_point in \ref mode(supervisor or user) with given stack
 762              	 * \param mode   privilege mode
 763              	 * \param stack   predefined stack, size should set enough
 764              	 * \param entry_point   a function pointer to execute
 765              	 */
 766              	__STATIC_FORCEINLINE void __switch_mode(uint8_t mode, uintptr_t stack, void(*entry_point)(void))
 767              	{
 768              	    unsigned long val = 0;
 769              	
 770              	    /* Set MPP to the requested privilege mode */
 771              	    val = __RV_CSR_READ(CSR_MSTATUS);
 772              	    val = __RV_INSERT_FIELD(val, MSTATUS_MPP, mode);
 773              	
 774              	    /* Set previous MIE disabled */
 775              	    val = __RV_INSERT_FIELD(val, MSTATUS_MPIE, 0);
 776              	
 777              	    __RV_CSR_WRITE(CSR_MSTATUS, val);
 778              	
 779              	    /* Set the entry point in MEPC */
 780              	    __RV_CSR_WRITE(CSR_MEPC, (unsigned long)entry_point);
 781              	
 782              	    /* Set the register file */
 783              	    __ASM volatile("mv sp, %0" ::"r"(stack));
 784              	
 785              	    __ASM volatile("mret");
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccSz8prT.s 			page 16


 786              	}
