 1218              	
 1219              	/**
 1220              	 * \brief   Get cluster id of current cluster in supervisor mode
 1221              	 * \details This function will get cluster id of current cluster in a multiple cluster system
 1222              	 * \return  The cluster id of current cluster
 1223              	 * \remarks hartid bit 15-8 is designed for cluster id in nuclei subsystem reference design
 1224              	 * \attention function is allowed in machine/supervisor mode,
 1225              	 * currently only present in 600/900 series from 2024 released version
 1226              	 */
 1227              	__STATIC_FORCEINLINE unsigned long __get_cluster_id_s(void)
 1228              	{
 1229              	    unsigned long id;
 1230              	
 1231              	    id = (__RV_CSR_READ(CSR_SHARTID) >> 8) & 0xFF;
 1232              	    return id;
 1233              	}
 1234              	
 1235              	/**
 1236              	 * \brief   Get hart index of current cluster in supervisor mode
 1237              	 * \details This function will get hart index of current cluster in a multiple cluster system,
 1238              	 * hart index is hartid - hartid offset, for example if your hartid is 1, and offset is 1, then
 1239              	 * hart index is 0
 1240              	 * \return  The hart index of current cluster
 1241              	 * \attention function is allowed in machine/supervisor mode,
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccSz8prT.s 			page 24


 1242              	 * currently only present in 600/900 series from 2024 released version
 1243              	 */
 1244              	__STATIC_FORCEINLINE unsigned long __get_hart_index_s(void)
 1245              	{
 1246              	    unsigned long id;
 1247              	#ifdef __HARTID_OFFSET
 1248              	    id = __RV_CSR_READ(CSR_SHARTID) - __HARTID_OFFSET;
 1249              	#else
 1250              	    id = __RV_CSR_READ(CSR_SHARTID);
 1251              	#endif
 1252              	    return id;
 1253              	}
 1254              	
 1255              	/**
 1256              	 * \brief   Get hart id of current cluster in supervisor mode
 1257              	 * \details This function will get hart id of current cluster in a multiple cluster system
 1258              	 * \return  The hart id of current cluster
 1259              	 * \remarks it will return full hartid not part of it for reference subsystem design,
 1260              	 * if your reference subsystem design has hartid offset, please define __HARTID_OFFSET in
 1261              	 * <Device>.h
