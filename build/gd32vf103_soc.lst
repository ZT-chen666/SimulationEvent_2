 1090              	#elif __RISCV_XLEN == 64
 1091              	    __RV_CSR_WRITE(CSR_MCYCLE, cycle);
 1092              	#else // TODO Need cover for XLEN=128 case in future
 1093              	#endif
 1094              	}
