 1919              	 *          Exception should trigger in supervisor mode or user mode.
 1920              	 */
 1921              	__STATIC_FORCEINLINE void __set_medeleg(unsigned long mask)
 1922              	{
 1923              	    __RV_CSR_WRITE(CSR_MEDELEG, mask);
 1924              	}
 1925              	
GAS LISTING C:\Users\Administrator\AppData\Local\Temp\ccSz8prT.s 			page 36


 1926              	/**
 1927              	 * \brief Execute fence instruction, p -> pred, s -> succ
 1928              	 * \details
 1929              	 * the FENCE instruction ensures that all memory accesses from instructions preceding
 1930              	 * the fence in program order (the `predecessor set`) appear earlier in the global memory order tha
 1931              	 * memory accesses from instructions appearing after the fence in program order (the `successor set
 1932              	 * For details, please refer to The RISC-V Instruction Set Manual
 1933              	 * \param p     predecessor set, such as iorw, rw, r, w
 1934              	 * \param s     successor set, such as iorw, rw, r, w
 1935              	 **/
 1936              	#define __FENCE(p, s) __ASM volatile ("fence " #p "," #s : : : "memory")
 1937              	
 1938              	/**
 1939              	 * \brief   Fence.i Instruction
 1940              	 * \details
 1941              	 * The FENCE.I instruction is used to synchronize the instruction
 1942              	 * and data streams.
 1943              	 */
 1944              	__STATIC_FORCEINLINE void __FENCE_I(void)
 1945              	{
 1946              	    __ASM volatile("fence.i");
 1947              	}
 1948              	
 1949              	/** \brief Read & Write Memory barrier */
 1950              	#define __RWMB()        __FENCE(iorw,iorw)
 1951              	
 1952              	/** \brief Read Memory barrier */
 1953              	#define __RMB()         __FENCE(ir,ir)
 1954              	
 1955              	/** \brief Write Memory barrier */
 1956              	#define __WMB()         __FENCE(ow,ow)
 1957              	
 1958              	/** \brief SMP Read & Write Memory barrier */
 1959              	#define __SMP_RWMB()    __FENCE(rw,rw)
 1960              	
 1961              	/** \brief SMP Read Memory barrier */
 1962              	#define __SMP_RMB()     __FENCE(r,r)
 1963              	
 1964              	/** \brief SMP Write Memory barrier */
 1965              	#define __SMP_WMB()     __FENCE(w,w)
 1966              	
 1967              	/** \brief CPU relax for busy loop */
 1968              	#define __CPU_RELAX()   __ASM volatile ("" : : : "memory")
 1969              	
 1970              	
