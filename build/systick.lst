 674              	 * \param csr   CSR macro definition defined in
 675              	 *              \ref NMSIS_Core_CSR_Registers, eg. \ref CSR_MSTATUS
 676              	 * \param val   Mask value to be used wih csrrs instruction
 677              	 * \return the CSR register value before written
 678              	 */
 679              	#define __RV_CSR_READ_SET(csr, val)                             \
 680              	    ({                                                          \
 681              	        rv_csr_t __v = (rv_csr_t)(val);                         \
 682              	        __ASM volatile("csrrs %0, " STRINGIFY(csr) ", %1"       \
 683              	                     : "=r"(__v)                                \
 684              	                     : "rK"(__v)                                \
 685              	                     : "memory");                               \
 686              	        __v;                                                    \
 687              	    })
