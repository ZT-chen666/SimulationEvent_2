 597              	/**
 598              	 * \defgroup NMSIS_Core_CSR_Register_Access    Core CSR Register Access
 599              	 * \ingroup  NMSIS_Core
 600              	 * \brief    Functions to access the Core CSR Registers
 601              	 * \details
 602              	 *
 603              	 * The following functions or macros provide access to Core CSR registers.
 604              	 * - \ref NMSIS_Core_CSR_Encoding
 605              	 * - \ref NMSIS_Core_CSR_Registers
